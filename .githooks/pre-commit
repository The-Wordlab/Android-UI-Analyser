#!/usr/bin/env bash
#
# Keep both SKILL.md copies and Codex UI metadata regenerated from guide.py (the single
# source) so they never drift.
#
# Idempotent and NON-BLOCKING: if the dev env (`aua`) isn't available, it warns and skips
# rather than failing the commit. Enable once per clone:
#
#     git config core.hooksPath .githooks
#
set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$root" || exit 0

# Prefer the project venv; fall back to module invocation, then PATH.
if [ -x ".venv/bin/aua" ]; then
  run_aua() { ./.venv/bin/aua "$@"; }
elif [ -x ".venv/bin/python" ]; then
  run_aua() { ./.venv/bin/python -m android_ui_analyser.cli "$@"; }
elif command -v aua >/dev/null 2>&1; then
  run_aua() { command aua "$@"; }
else
  echo "pre-commit: 'aua' unavailable — skipping SKILL.md sync (install the dev env to enable)." >&2
  exit 0
fi

project=".claude/skills/android-ui-analyser/SKILL.md"
plugin="skills/android-ui-analyser/SKILL.md"
codex_metadata="skills/android-ui-analyser/agents/openai.yaml"

for path in "$project" "$plugin"; do
  if ! run_aua guide --emit-skill "$path" >/dev/null 2>&1; then
    echo "pre-commit: 'aua guide --emit-skill $path' failed — skipping SKILL.md sync." >&2
    exit 0
  fi
done

if ! run_aua guide --emit-codex-metadata "$codex_metadata" >/dev/null 2>&1; then
  echo "pre-commit: Codex metadata sync failed — skipping generated-skill sync." >&2
  exit 0
fi

git add -- "$project" "$plugin" "$codex_metadata"
if ! git diff --cached --quiet -- "$project" "$plugin" "$codex_metadata"; then
  echo "pre-commit: re-synced generated agent skills from guide.py." >&2
fi

# --- Blocking: ruff + mypy (~1s together, mypy is incremental) --------------------------
#
# These are cheap and they are the only gate this repo has: there is no CI workflow, and the
# test suite cannot catch the failure mode they catch. A call to a method that does not exist,
# sitting inside one of ~150 `contextlib.suppress(Exception)` blocks, raises silently and takes
# the feature with it — that is how the per-control timing feature stayed dead from the commit
# that introduced it. mypy names it; a green test suite does not.
#
# Both skip when the tool is absent so a fresh clone can still commit. `--no-verify` bypasses.
if [ -x ".venv/bin/ruff" ]; then
  if ! .venv/bin/ruff check . >&2; then
    echo "pre-commit: ruff found problems (above). Fix them, or commit with --no-verify." >&2
    exit 1
  fi
fi

if [ -x ".venv/bin/mypy" ]; then
  if ! .venv/bin/mypy >&2; then
    echo "pre-commit: mypy found problems (above). An [attr-defined] error inside a" >&2
    echo "            suppressed-exception block means a silently dead feature, not a nit." >&2
    echo "            Fix them, or commit with --no-verify." >&2
    exit 1
  fi
fi

exit 0
