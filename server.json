{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.The-Wordlab/aua",
  "title": "AUA (Android UI Analyser)",
  "description": "See and operate Android, iOS-simulator and web UIs by stable element ID, not pixels.",
  "version": "0.49.0",
  "websiteUrl": "https://the-wordlab.github.io/Android-UI-Analyser/",
  "repository": {
    "url": "https://github.com/The-Wordlab/Android-UI-Analyser",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "aua",
      "version": "0.49.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
