{
  "manifest_version": 3,
  "name": "AUA Existing Chrome Tab",
  "version": "0.1.0",
  "description": "Share one explicitly selected Chrome tab with Android UI Analyser.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "AUA tab access",
    "default_popup": "popup.html"
  }
}
